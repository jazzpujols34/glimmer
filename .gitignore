# OS
.DS_Store

# Node
node_modules/
.next/
out/
build/

# Env & secrets
.env
.env.local
.env.*.local
service-account.json
*.json.key
*.pem

# Confidential docs (but allow screenshots for README)
docs/*
!docs/screenshots/

# Debug
npm-debug.log*
yarn-debug.log*
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/

# Compound system
logs/
tasks/
scripts/compound/prd.json

# Claude Code
.claude/

# Demo videos (large files, includes client demo bundles in subfolders)
demo-videos/

# Temporary media (large binary files)
tmp-music/
scripts/demo-photos/

# Generated script output
scripts/batch-jobs.json
scripts/batch-results.json

# Prompt reference files
prompts/

# Python bytecode — cloud-run/ services are Python; running or importing them
# locally drops __pycache__ into the tree with no rule to catch it.
__pycache__/
*.pyc
