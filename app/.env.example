# BytePlus Seedance (Recommended - Image-to-Video)
BYTEPLUS_API_KEY=your-byteplus-api-key
BYTEPLUS_MODEL_ID=your-byteplus-model-id

# Google Cloud Platform (for Veo 3.1)
GOOGLE_CLOUD_PROJECT_ID=your-project-id
VERTEX_AI_LOCATION=us-central1

# Kling AI (optional - for Kling model)
KLING_ACCESS_KEY=your-kling-access-key
KLING_SECRET_KEY=your-kling-secret-key

# OpenAI (Whisper transcription in editor)
OPENAI_API_KEY=sk-...

# Payment (Stripe for now — will swap to ECPay)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYMENT_PRICE_SINGLE=price_...
PAYMENT_PRICE_PACK5=price_...

# Email verification (Resend)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin (comma-separated emails with unlimited credits)
ADMIN_EMAILS=your-admin@example.com

# Daily provider-spend circuit breaker: max estimated BytePlus tokens per UTC
# day before /api/generate, /api/generate-batch, /api/quick-generate refuse
# new generations (see src/lib/spend-guard.ts). Unset = default 15,000,000
# (~US$18/day at $0.0012/K tokens). "0" disables the cap.
DAILY_PROVIDER_TOKEN_CAP=

# Admin API shared secret — required in addition to ADMIN_EMAILS for every
# /api/admin/* route. Client sends it as the `x-admin-secret` header.
# If unset/empty, ALL admin routes deny (fail closed). Set your own value in
# production; never commit a real secret here.
ADMIN_SECRET=

# Server-side Export (Cloud Run)
EXPORT_SERVICE_URL=https://glimmer-export-xxx.asia-east1.run.app

# SSRF allowlist for export-server/storyboard-export URL fetching (comma-separated
# host suffixes, e.g. "new-provider-cdn.com,other-cdn.example"). Own origin and
# BytePlus CDN hosts are always allowed; use this to allow a new provider CDN
# without a code deploy. Empty by default.
EXPORT_URL_ALLOWED_HOSTS=

# Error Monitoring (Sentry)
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Telegram admin alerts (optional — both must be set or alerts are a silent
# no-op). Fires on: successful ECPay payment, daily provider-spend cap breach
# (once per UTC day). See src/lib/telegram.ts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Session / identity (progressive Google + email magic-link login) ---
# SESSION_SECRET signs the session cookie (HMAC-SHA256). Required for any
# login to work — without it signSession() throws and OAuth fails.
# Generate with: openssl rand -base64 48
SESSION_SECRET=your-long-random-session-secret

# Google OAuth client (GCP console > APIs & Services > Credentials).
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# Session enforcement on spend/destructive/read routes. Unset or anything
# other than "true" is a pure no-op. Arms per account at first sign-in, so
# turning it on never locks out an account that has never signed in.
REQUIRE_SESSION_FOR_PAID=false

# --- ECPay (Taiwan payments) ---
ECPAY_MERCHANT_ID=your-merchant-id
ECPAY_HASH_KEY=your-hash-key
ECPAY_HASH_IV=your-hash-iv
ECPAY_TEST_MODE=true

# --- Vertex AI (Veo) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- Misc ---
# Absolute base URL used in emails and OAuth redirects.
NEXT_PUBLIC_BASE_URL=http://localhost:3200
