{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glimmer-worker",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-01-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "glimmer-worker" }],
  "kv_namespaces": [{ "binding": "GLIMMER_KV", "id": "cdfb901d54024c0c839ceddb65f6ec7a" }],
  "r2_buckets": [{ "binding": "GLIMMER_R2", "bucket_name": "glimmer-videos" }],
  "observability": { "enabled": true }
}
